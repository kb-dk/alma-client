<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:documentation>
			Lending resource sharing request
		</xs:documentation>
	</xs:annotation>
	
        <xs:include schemaLocation="rest_rs_offer_details.xsd"/>
        <xs:include schemaLocation="rest_rs_request_details.xsd"/>
        <xs:include schemaLocation="rest_rs_request_costs.xsd"/>
        <xs:include schemaLocation="rest_rapido_attributes.xsd"/>

	<xs:element name="lending_resource_sharing_request" type="lending_resource_sharing_request"/>

	<xs:complexType name="lending_resource_sharing_request">
		<xs:annotation>
			<xs:documentation>Lending resource sharing request Object</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="request_id" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
				Internal identifier of the resource sharing request in Alma, generated by Alma.
				Should be used in subsequent queries regarding the request.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>1001966830001021</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="external_id" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						External identifier of the resource sharing request.
						Mandatory when creating a lending request.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>ext1234567</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="created_date" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The request creation date.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>2013-11-12Z</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="last_modified_date" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Date by which the last change to the request was made.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>2015-10-11Z</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="shipping_date" type="xs:dateTime" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The date the item was shipped to the borrower.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>2019-12-18T14:36:48.659Z</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="created_time" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
				<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>2019-12-18T14:36:48.659Z</xs:example>
					</xs:appinfo>
					<xs:documentation>The request creation time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="last_modified_time" type="xs:dateTime" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>2019-12-18T14:36:48.659Z</xs:example>
					</xs:appinfo>
					<xs:documentation>
						Time by which the last change to the request was made.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="status" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>ACTIVE</xs:example>
					</xs:appinfo>
					<xs:documentation>
					The resource sharing request status.
					Possible codes are listed in MandatoryLendingWorkflowSteps or OptionalLendingWorkflowSteps [code tables|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API].
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="owner" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
					The resource sharing library code. Mandatory.
					See [Get libraries API|https://developers.exlibrisgroup.com/alma/apis/conf/GET/gwPcGly021p29HpB7XTI4Dp4I8TKv6CAxBlD4LyRaVE=/37088dc9-c685-4641-bc7f-60b5ca7cabed].
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>John Smith</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="partner" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						The code of the partner related to this request. See [Get partners API|https://developers.exlibrisgroup.com/alma/apis/partners/GET/gwPcGly021piAVNPLaef7suP1zfa6Lui/8883ef41-c3b8-4792-9ff8-cb6b729d6e07].
						Mandatory when creating a lending request.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>10218885421021</xs:example>
					</xs:appinfo>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
							<xs:attribute name="link" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="user_request" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example></xs:example>
					</xs:appinfo>
					<xs:documentation>
						The request linked to the resource sharing request. The move/digitization request (if exists).
						See [GET user's request API|https://developers.exlibrisgroup.com/alma/apis/users/GET/gwPcGly021r0XQMGAttqcPPFoLNxBoEZbQsUC/MWTX7aNWi0EYKYFUfYyI8KvpG73JPdiJpJhUA=/0aa8d36f-53d6-48ff-8996-485b90b103e4].
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="link" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="requested_media" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>1</xs:example>
						<xs:codeTable>requested_media</xs:codeTable>
					</xs:appinfo>
					<xs:documentation>
						A description of the requested media.
						possible values are 1-7 (codes from request media code table), and the codes from 'AdditionalRequestedMedia' [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API]. The valid values are according to the "Requested media definition" mapping table.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="format" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:codeTable>RequestFormats</xs:codeTable>
						<xs:tags>api get post</xs:tags>
						<xs:example>PHYSICAL</xs:example>
					</xs:appinfo>
					<xs:documentation>
					Format of the resource requested. For example, physical or digital.
					Mandatory. Possible codes are listed in RequestFormats [code tables|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API].
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="allow_other_formats" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Indication whether other formats besides the value in format field are acceptable.
						Default is false.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>true</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="supplied_format" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:codeTable>RequestFormats</xs:codeTable>
						<xs:tags>api get</xs:tags>
						<xs:example>DIGITAL</xs:example>
					</xs:appinfo>
					<xs:documentation>
						Format of the supplied item. For example, physical or digital.
						Possible codes are listed in RequestFormats [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API].
						Relevant only after the request is supplied.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="requested_language" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:codeTable>ResourceSharingLanguages</xs:codeTable>
						<xs:example>ml</xs:example>
						<xs:tags>api get post</xs:tags>
					</xs:appinfo>
					<xs:documentation>
						The requested language for the resource sharing request.
						Possible codes are the enabled fields in ResourceSharingLanguages [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API]. Default is null.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="pickup_location_type"  type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>LIBRARY</xs:example>
					</xs:appinfo>
					<xs:documentation>The pickup location type.
					The pickup location type. Possible values are: LIBRARY, CIRCULATION_DESK.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="last_interest_date" type="xs:date" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Last date the request is needed. Optional.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>2013-12-13Z</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="text_email" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Requester's Email.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example></xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="shipping_cost" type="amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
					</xs:appinfo>
					<xs:documentation>The shipping cost. Optional.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="lost_damaged_fee" type="amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
					</xs:appinfo>
					<xs:documentation>The Lost/Damaged Item Fee. Optional.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="request_cost" type="amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
					</xs:appinfo>
					<xs:documentation>The Patron Request Cost. Optional.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="receive_cost" type="amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
					</xs:appinfo>
					<xs:documentation>The Patron Receive Cost. Optional.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="fund">
				<xs:annotation>
					<xs:appinfo>
						<xs:tags>get post</xs:tags>
						<xs:example></xs:example>
					</xs:appinfo>
					<xs:documentation>
							The code of the fund.
							Not relevant for lending requests.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="copyright_status" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:codeTable>ResourceSharingCopyrightsStatus</xs:codeTable>
						<xs:example>APPROVED</xs:example>
						<xs:tags>api get post</xs:tags>
					</xs:appinfo>
					<xs:documentation>
						The copyright status of the request. Relevant if requested format is Digital, and 'rs_borrower_copyright_management' in customer parameters is true.
						Possible options are listed in 'ResourceSharingCopyrightsStatus' [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API], default is generated per request.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="citation_type" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>
						<xs:codeTable>PhysicalReadingListCitationTypes</xs:codeTable>
						<xs:example>BK</xs:example>
						<xs:tags>api get post</xs:tags>
					</xs:appinfo>
					<xs:documentation>
						Type of the requested resource. For example, book or article.
						Mandatory when creating a lending request unless mms_id is supplied.
						Possible codes are listed in PR_CitationType [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API]: BOOK / JOURNAL.
					</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="note" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>General note.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example></xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="has_active_notes" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Indication whether the request has active notes.
						Output parameter.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>false</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="rs_notes" type="rs_notes" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The requests's related notes.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="printed" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Indication whether the request is printed. Output parameter.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>true</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="reported" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Indication whether the request is reported. Output parameter.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get</xs:tags>
						<xs:example>false</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="level_of_service" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						The code of the resource sharing request Level of Service.
						Possible options are listed in 'LevelOfService' [code table|https://developers.exlibrisgroup.com/blog/Working-with-the-code-tables-API], default is generated per request.
					</xs:documentation>
					<xs:appinfo>
						<xs:codeTable>LevelOfService</xs:codeTable>
						<xs:tags>api get post</xs:tags>
						<xs:example>NORMAL_LOCAL</xs:example>
					</xs:appinfo>
				</xs:annotation>
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
							<xs:attribute name="desc" type="xs:string" use="optional"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<!--  Resource Information  -->
			<xs:element name="mms_id" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						MMS ID of the requested resource.
						If supplied when creating a request, the request will be attached to this bib record.
						See [GET BIB API|https://developers.exlibrisgroup.com/alma/apis/bibs/GET/gwPcGly021om4RTvtjbPleCklCGxeYAf3JPdiJpJhUA=/af2fb69d-64f4-42bc-bb05-d8a0ae56936e].
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>9933745180101020</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="barcode" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Barcode of the requested resource.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>00023705571000021</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="title" type="xs:string" minOccurs="0" maxOccurs="1" nillable="false">
				<xs:annotation>
					<xs:documentation>
						Title of the requested resource.
						Mandatory unless mms_id is supplied.
					</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>Harry Potter</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="issn" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>ISSN of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example></xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="isbn" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>ISBN of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>0674824253 (alk. paper)</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="author" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Author of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>John Smith</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="author_initials" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Author initials of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>J.S</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="year" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Publication date of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>2010</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="publisher" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Publisher of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>John Smith</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="place_of_publication" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The publication place of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>Cambridge, Mass. :</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="edition" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The edition of the requested resource.</xs:documentation>
					<xs:appinfo>
						<xs:tags>api get post</xs:tags>
						<xs:example>1</xs:example>
					</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="specific_edition" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						Indication whether edition is used in ISO Protocol and in Locate process. Default is true.
